# jellyfinflatcar.tf - linked clone of the Flatcar template, configured by Ignition
TF_VAR_proxmox_host_endpoint=""
TF_VAR_proxmox_environment_secret="root@pam!NameOfKey=secretvaluegoeshere"

TF_VAR_node_name="plex"

TF_VAR_vm_name="jellyfin"
TF_VAR_vm_ip="192.168.1.61"
TF_VAR_vm_gateway="192.168.1.100"
TF_VAR_vm_cidr="24"
TF_VAR_vm_dns='["1.1.1.1", "1.0.0.1"]' # HCL list literal - single-quoted so `source .env` keeps it verbatim

TF_VAR_image_user="williamewanchuk"
TF_VAR_ssh_public_key="" # goes into the Ignition config for both `core` and image_user

TF_VAR_proxmox_datastore_id="proxmox-templates" # must allow the "snippets" content type
TF_VAR_template_vm_id="106"
TF_VAR_proxmox_ssh_username="root"
TF_VAR_proxmox_ssh_key_path="~/.ssh/id_ed25519"

# jellyfinflatcar.tf - dedicated NFS export for media/config, mounted by a systemd unit from Ignition
TF_VAR_nfs_server="192.168.1.50"
TF_VAR_nfs_jellyfin_export="/mnt/storage/jellyfin"
TF_VAR_nfs_jellyfin_mount_point="/mnt/jellyfin"

# jellyfinflatcar.tf - Proxmox firewall (inbound: LAN on 8096 + admin SSH; outbound: NFS + public internet only)
TF_VAR_jellyfin_client_cidrs='["192.168.1.0/24"]'
TF_VAR_admin_cidrs='["192.168.1.100"]' # your workstation
